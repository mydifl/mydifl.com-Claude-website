{
  "name": "difl-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "node scripts/generate-teaching-method.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/preserve-legacy-site.mjs",
    "preview": "astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "extract:legacy": "node scripts/extract-legacy-content.mjs",
    "generate:method": "node scripts/generate-teaching-method.mjs",
    "audit": "node scripts/audit-build.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.8",
    "@supabase/supabase-js": "^2.112.4",
    "astro": "^7.3.2",
    "resend": "^6.24.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3",
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3"
  },
  "overrides": {
    "fast-uri": "3.1.6",
    "svgo": "4.1.0",
    "@vercel/routing-utils": {
      "path-to-regexp": "npm:path-to-regexp@6.3.0"
    }
  }
}
