{
  "name": "difl-website",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/preserve-legacy-site.mjs",
    "preview": "astro preview",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "extract:legacy": "node scripts/extract-legacy-content.mjs",
    "audit": "node scripts/audit-build.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "11.0.5",
    "@supabase/supabase-js": "2.112.3",
    "astro": "7.2.1",
    "resend": "6.19.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "npm:path-to-regexp@6.3.0"
    }
  }
}
